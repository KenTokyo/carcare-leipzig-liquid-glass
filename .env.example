# Umgebungsvariablen fuer den Formularversand (Backlog 1.17)
#
# EINZUTRAGEN IN VERCEL, nicht in eine Datei im Repository:
#   Project Settings -> Environment Variables
#
# Solange auch nur eine davon fehlt, sendet die Website NICHTS und sagt das auch:
# `api/anfrage.ts` antwortet mit 503, der Absenden-Knopf bleibt gesperrt und nennt
# Telefon und E-Mail. Es gibt also keinen Zustand, in dem eine Erfolgsmeldung erscheint,
# hinter der kein Versand steht.
#
# Diese Datei ist nur die Vorlage. Sie enthaelt keine Werte und gehoert ins Repository;
# eine echte `.env` gehoert es nicht.

# Schluessel des Mail-Dienstes (resend.com -> API Keys)
RESEND_API_KEY=

# Wohin die Anfragen gehen
ANFRAGE_EMPFAENGER=info@carcare-center.de

# Von welcher Adresse sie kommen. Muss bei Resend als Absender verifiziert sein,
# sonst weist der Dienst die Mail ab. Eine eigene Adresse der Domain verwenden,
# NICHT die Empfaengeradresse — sonst landen Antworten im eigenen Postfach.
ANFRAGE_ABSENDER=website@carcare-center.de
